# Docker Compose Environment Variables
# Copy this file to .env and update with your values

# Node Environment
NODE_ENV=production

# PostgreSQL Database Configuration (for local development)
POSTGRES_DB=pawnshop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_password

# Database URL - Use this for local PostgreSQL
# For Supabase or external PostgreSQL, update with your connection string
DATABASE_URL=postgresql://postgres:change_this_password@postgres:5432/pawnshop?sslmode=disable

# JWT secrets - MUST be changed to long random strings (e.g. `openssl rand -hex 32`)
SECRET_JWT_KEY=change-this-access-token-secret
REFRESH_JWT_KEY=change-this-refresh-token-secret

# CORS - Frontend URL
FRONTEND_URL=http://localhost

# Admin User Configuration
ADMIN_ID_NUMBER=12345678
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@pawnshop.com
ADMIN_DEFAULT_PASSWORD=change_this_admin_password

# Backend API URL (used by frontend)
VITE_API_URL=http://localhost:3000

# Port Configuration
BACKEND_PORT=3000
FRONTEND_PORT=80
